{
  "enabled": true,
  "provider": "resend",
  "scan_limit": 200,
  "max_emails_per_run": 5,
  "required_draft_status": "READY_FOR_REVIEW",
  "required_send_status": "READY_TO_SEND",
  "allowed_legal_bases": [
    "OPT_IN",
    "EXISTING_CUSTOMER",
    "MANUAL_LEGAL_APPROVAL"
  ],
  "rules": {
    "explicit_airtable_approval_required": true,
    "documented_legal_basis_required": true,
    "never_send_twice_when_message_id_exists": true,
    "mark_sent_only_after_provider_message_id": true,
    "no_automatic_legal_inference": true,
    "german_cold_email_not_auto_authorized": true
  }
}
